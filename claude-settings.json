{
  "skillListingMaxDescChars": 2048,
  "skillListingBudgetFraction": 0.03,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(bash /Users/tyrel/.codex/skills/*)",
      "Bash(bash /Users/tyrel/.claude/skills/*)",
      "Bash(sh /Users/tyrel/.codex/skills/*)",
      "Bash(sh /Users/tyrel/.claude/skills/*)",
      "Bash(python3 /Users/tyrel/.codex/skills/*)",
      "Bash(python3 /Users/tyrel/.claude/skills/*)",
      "Bash(python /Users/tyrel/.codex/skills/*)",
      "Bash(python /Users/tyrel/.claude/skills/*)",
      "Bash(/Users/tyrel/.codex/skills/*)",
      "Bash(/Users/tyrel/.claude/skills/*)",
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "Search",
      "WebSearch"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/tyrel/.claude/hooks/save-plan.sh",
            "timeout": 10,
            "statusMessage": "Saving plan to vault"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/tyrel/.claude/statusline-command.sh",
    "refreshInterval": 120
  },
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "sc-(?<id>\\d{4,6})",
      "url": "https://app.shortcut.com/giftbit/story/{id}",
      "label": "sc-{id}"
    }
  ],
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "coderabbit@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5": {
      "effortLevel": "low"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "precomputeCompactionEnabled": true,
  "autoContinueAtUsageLimit": true,
  "fileCheckpointingEnabled": true
}
